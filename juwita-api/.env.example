# Salin nilai dari /home/juwita/.juwita-one-db.env ke environment saat menjalankan.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/juwita_one
PORT=3000

# Geofence presensi (opsional). Default: Juwita Fresh & Frozen, radius 100 m.
# ATTENDANCE_STORE_LAT=-6.2589796
# ATTENDANCE_STORE_LNG=106.9813076
# ATTENDANCE_STORE_RADIUS_M=100

# Daftar UUID user (pisahkan koma) yang boleh melihat isi foto presensi.
# Kosongkan/tidak diisi = default akun Rizkin & Bos Warsito Broiler.
# ATTENDANCE_PHOTO_VIEWER_IDS=
